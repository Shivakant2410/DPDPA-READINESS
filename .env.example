# Copy to .env and fill in. Never commit .env.

# ---- Domain (used by docker-compose for HTTPS) ----
ASTRA_DOMAIN=astra.hypensec.com

# ---- Access (required in production) ----
# Comma-separated label:secret pairs. Secrets must be 16+ characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# The label (e.g. the customer's name) is written to the audit log with every scan.
ACCESS_KEYS=hypensec-team:CHANGE-ME-generate-a-long-random-secret

# ---- Your legal details (required in production; shown on /privacy.html and /terms.html) ----
LEGAL_ENTITY=HypenSec (registered company name)
PRIVACY_EMAIL=privacy@hypensec.com
GRIEVANCE_OFFICER=Full name, Grievance Officer
POSTAL_ADDRESS=Registered office address, City, State, PIN
HOSTING_LOCATION=India (Mumbai)
AUDIT_RETENTION=one year
LEGAL_LAST_UPDATED=26 September 2026

# ---- Limits ----
SCANS_PER_HOUR=30
SCANS_PER_HOUR_PER_IP=60
PDFS_PER_HOUR=120
MAX_CONCURRENT=2
MAX_QUEUE=10
SCAN_TIMEOUT_MS=150000

# ---- Network ----
# Set TRUST_PROXY=1 only when the service sits behind your reverse proxy (it then trusts X-Forwarded-For).
TRUST_PROXY=1
# Leave empty: the app is served from the same origin. Set only if another site calls the API.
ALLOWED_ORIGIN=

# ---- Scanner behaviour ----
# 1 (default): the scanner identifies itself as "HypenSecAstra" in its user agent.
# 0: looks like plain Chrome. Only for sites you own that block automated browsers.
SCANNER_IDENTIFY=1
